# Create .gitignore BEFORE adding files
cat > .gitignore << 'EOF'
# Environment files - NEVER COMMIT THESE!
.env
.env.local
.env.production
.env.development
.env*.local

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
*.pid
*.seed

# Logs
logs
*.log

# Coverage directory
coverage/
.nyc_output

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/

# Uploads
uploads/
public/uploads/

# Database backups
database/backup/*.sql
!database/backup/README.md

# Sensitive data
secrets/
keys/
*.pem
*.key

# Build output
dist/
build/
EOF

echo "✅ .gitignore created"